{
  "name": "punto",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:engine-original": "node design/logic/test.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/design/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
