# Ajustes de la demo (Fase 2, sin backend). Copiá a .env.local si querés cambiarlos.
# No hay claves ni secretos: Supabase se configura en la Fase 3.
EXPO_PUBLIC_DEMO_ESCENARIO=demo            # demo | usuario-nuevo | grupo-sin-partidos
EXPO_PUBLIC_DEMO_ERROR_DE_RED=0            # 1 = el primer guardado falla y conserva lo cargado
EXPO_PUBLIC_DEMO_NOMBRES_LARGOS=0          # 1 = nombres de grupo y jugador largos (truncado)
EXPO_PUBLIC_DEMO_CARGA=1                   # 0 = sin esqueleto de carga al abrir
