# --- Cuentas y datos (Supabase) ---------------------------------------------------------
# Con estas dos variables la app usa cuentas y datos persistentes. Sin ellas corre en modo demo.
# Son PÚBLICAS (van dentro de la app): usar la clave anon / publishable. NUNCA la service-role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Ajustes de la demo (sin Supabase) ----------------------------------------------------
# Copiá a .env.local si querés cambiarlos. No hay claves ni secretos.
EXPO_PUBLIC_DEMO_ESCENARIO=demo            # demo | usuario-nuevo | grupo-sin-partidos
EXPO_PUBLIC_DEMO_ERROR_DE_RED=0            # 1 = el primer guardado falla y conserva lo cargado
EXPO_PUBLIC_DEMO_NOMBRES_LARGOS=0          # 1 = nombres de grupo y jugador largos (truncado)
EXPO_PUBLIC_DEMO_CARGA=1                   # 0 = sin esqueleto de carga al abrir
